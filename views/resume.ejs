<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Resume of <%= resume.name %>">
  <title><%= resume.name %> | Resume</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="resume">
    <header class="resume-header">
      <h1><%= resume.name %></h1>
      <div class="contact-line">
        <a href="mailto:<%= resume.email %>"><%= resume.email %></a>
        <span class="separator">|</span>
        <a href="tel:<%= resume.phone.replace(/\s/g, '') %>"><%= resume.phone %></a>
        <span class="separator">|</span>
        <span><%= resume.location %></span>
      </div>
    </header>

    <section class="section">
      <h2>Profile</h2>
      <p><%= resume.summary %></p>
    </section>

    <section class="section">
      <h2>Education</h2>
      <% resume.education.forEach(function(item) { %>
        <div class="entry">
          <div class="entry-heading">
            <h3><%= item.degree %></h3>
            <% if (item.period) { %><span class="period"><%= item.period %></span><% } %>
          </div>
          <p class="institution"><%= item.institution %></p>
          <% if (item.result) { %><p class="detail"><%= item.result %></p><% } %>
        </div>
      <% }); %>
    </section>

    <section class="section">
      <h2>Technical Skills</h2>
      <p><%= resume.technicalSkills.join("  •  ") %></p>
    </section>

    <section class="section">
      <h2>Soft Skills</h2>
      <p><%= resume.softSkills.join("  •  ") %></p>
    </section>

    <section class="section">
      <h2>Hobbies & Interests</h2>
      <p><%= resume.hobbies.join("  •  ") %></p>
    </section>

    <section class="section">
      <h2>Languages</h2>
      <p><%= resume.languages.join("  •  ") %></p>
    </section>
  </main>
</body>
</html>
